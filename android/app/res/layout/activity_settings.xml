<?xml version="1.0" encoding="utf-8"?>
<!--
  外层 FrameLayout 负责两件事：
    1. 系统栏留白（sys_top_padding / sys_bottom_padding，v35 上才非 0）
    2. 内容最大宽度约束 —— 屏幕比 content_max_width 宽时，内容居中不再横向铺满
  手机竖屏下这两个值都不影响观感，只在横屏/平板/折叠屏上起作用。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:paddingTop="@dimen/sys_top_padding"
    android:paddingBottom="@dimen/sys_bottom_padding">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_url" />

            <EditText
                android:id="@+id/inputUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_url"
                android:inputType="textUri"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text_main"
                android:textColorHint="#FF58708C"
                android:textSize="14sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_token" />

            <EditText
                android:id="@+id/inputToken"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_token"
                android:inputType="text"
                android:longClickable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text_main"
                android:textColorHint="#FF58708C"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPasteToken"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_paste_token" />

            <CheckBox
                android:id="@+id/checkRelaxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/accent"
                android:text="@string/label_relaxed"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_ua" />

            <EditText
                android:id="@+id/inputUa"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_ua"
                android:importantForAutofill="no"
                android:inputType="text"
                android:longClickable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text_main"
                android:textColorHint="#FF58708C"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_save" />

                <Button
                    android:id="@+id/btnTest"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_test" />
            </LinearLayout>

            <TextView
                android:id="@+id/testResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电脑端提示" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/helpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCopyHint"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:text="复制网关启动命令" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关于" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/aboutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClose"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:text="回到会话" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</FrameLayout>
